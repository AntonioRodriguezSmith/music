{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clip_harbour",
  "version": "0.1.0",
  "identifier": "com.clip-harbour.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clip_harbour",
        "width": 1440,
        "height": 810,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
