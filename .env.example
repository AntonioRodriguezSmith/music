# Optional default download folder (Windows path). Copied by Vite as VITE_*.
# After first "Choose Path" in the app, the selection is stored in localStorage.
VITE_DEFAULT_DOWNLOAD_PATH=C:\Users\YourName\Music

# Build flag móvil (Android): activa la ruta /player y el shell móvil. La build
# móvil lo inyecta vía `.env.mobile` (vite build --mode mobile, `npm run build:mobile`).
# En desktop puedes activarlo para desarrollo del Player:
VITE_ENABLE_PLAYER=0

# YouTube bot-check (used by Rust if set in the process env — prefer the sidebar UI):
# CLIP_HARBOUR_COOKIES=C:\Users\YourName\cookies_youtube\cookies_chrome.txt
# CLIP_HARBOUR_COOKIES_FROM_BROWSER=firefox
# Folder scanned at startup for cookies.txt candidates (default: C:\Users\<user>\cookies_youtube):
# CLIP_HARBOUR_COOKIES_DIR=C:\Users\YourName\cookies_youtube
