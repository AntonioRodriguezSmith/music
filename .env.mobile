# Build flag exclusivo de la build móvil (Android): activa la ruta /player
# (src/lib/feature_flags.js exige VITE_ENABLE_PLAYER=1). Vite lo carga con
# `vite build --mode mobile` (script `build:mobile` en package.json),
# que `tauri.android.conf.json` usa como beforeBuildCommand.
VITE_ENABLE_PLAYER=1
